{
    "name": "newsreel",
    "version": "0.1.0",
    "description": "Build narrated videos from a config file: reports, demos, ads, launch films. Playwright drives your real app, narration runs locally, ffmpeg assembles it with cards, a music bed and 35 generated scenes",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/e3o8o/newsreel.git"
    },
    "bugs": {
        "url": "https://github.com/e3o8o/newsreel/issues"
    },
    "homepage": "https://newsreel.pages.dev",
    "type": "commonjs",
    "bin": {
        "newsreel": "bin/newsreel.cjs"
    },
    "main": "lib/config.cjs",
    "files": [
        "bin",
        "lib",
        "templates",
        "assets",
        "visuals/harness",
        "visuals/primitives",
        "visuals/assets",
        "visuals/catalog.json",
        "visuals/LOOKBOOK.md",
        "AGENT.md",
        "README.md",
        "LICENSE"
    ],
    "engines": {
        "node": ">=18.0.0"
    },
    "scripts": {
        "test": "node test/run.cjs"
    },
    "keywords": [
        "demo",
        "demo-video",
        "screencast",
        "playwright",
        "ffmpeg",
        "changelog",
        "release-notes",
        "screen-recording",
        "product-demo",
        "cli"
    ],
    "peerDependencies": {
        "@playwright/test": ">=1.30.0",
        "playwright": ">=1.30.0"
    },
    "peerDependenciesMeta": {
        "@playwright/test": {
            "optional": true
        },
        "playwright": {
            "optional": true
        }
    },
    "devDependencies": {
        "playwright": "^1.61.0"
    }
}
